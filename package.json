{
  "name": "dsh-m",
  "version": "0.10.21",
  "description": "可自定义收录清单的 DSH 插件市场：收录、安装、卸载、升级一站完成，附 agent 工具与 dshm CLI。",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "bin": {
    "dshm": "lib/cli.js"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "registry.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "marketplace",
    "registry"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/dsh-m.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/check-client-imports.mjs && node --test tests/*.test.mjs",
    "check-release": "node scripts/check-release.mjs",
    "release": "node scripts/release.mjs",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "capture:readme": "node scripts/capture-readme.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1 || >=0.2.0",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.2"
  },
  "dependencies": {
    "semver": "7.8.5",
    "undici": "8.12.3",
    "yaml": "2.9.1"
  }
}
